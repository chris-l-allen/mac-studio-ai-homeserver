<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.homeddr</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/callen/home-ddr/scripts/serve.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/callen/home-ddr</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOMEDDR_HOST</key>
        <string>0.0.0.0</string>
        <key>HOMEDDR_PORT</key>
        <string>8787</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/callen/home-ddr/homeserver.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/callen/home-ddr/homeserver.err.log</string>
</dict>
</plist>
