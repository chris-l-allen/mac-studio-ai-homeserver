<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Keep Ollama running as a background service (starts at login / boot).

  Install:
    cp launchd/com.local.ollama.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.local.ollama.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.local.ollama.plist
    rm ~/Library/LaunchAgents/com.local.ollama.plist

  Adjust ProgramArguments if Ollama is not at /usr/local/bin/ollama.
  Homebrew installs it at /opt/homebrew/bin/ollama.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.local.ollama</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/ollama</string>
        <string>serve</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>OLLAMA_HOST</key>
        <string>0.0.0.0:11434</string>
        <key>OLLAMA_KEEP_ALIVE</key>
        <string>-1</string>
        <key>OLLAMA_CONTEXT_LENGTH</key>
        <string>32768</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/ollama.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ollama.err</string>
</dict>
</plist>
