# Unified .allen reverse proxy for the home server.
#
# Every host below is LAN-only: the `allen` DNS zone is served by the portal
# (services/network/server.py). Nothing is exposed to the public internet.
#
# Paths use {$HOME}; launchd sets HOME=/Users/<you> for the Caddy unit.
# Set LAN_IP in the launchd plist to this server's static LAN address.
{
	log {
		output file {$HOME}/mac-studio-ai-homeserver/services/network/data/access.log
		format json
	}
	# Disable HTTP/3 (QUIC): some clients fail on UDP:443 and don't fall back.
	servers {
		protocols h1 h2
	}
}

# --- .allen pages ---------------------------------------------------------

# Poker game (node, plain HTTP backend)
poker.allen {
	tls {$HOME}/mac-studio-ai-homeserver/services/network/data/tls/poker.allen.crt {$HOME}/mac-studio-ai-homeserver/services/network/data/tls/poker.allen.key
	reverse_proxy 127.0.0.1:8080
}

# Home network portal (HTTPS backend on :8443)
homenetwork.allen {
	tls {$HOME}/mac-studio-ai-homeserver/services/network/data/tls/homenetwork.allen.crt {$HOME}/mac-studio-ai-homeserver/services/network/data/tls/homenetwork.allen.key

	handle /set-dns.command {
		root * {$HOME}/mac-studio-ai-homeserver/services/network
		file_server
	}

	handle /dns-profile.mobileconfig {

		header Content-Type application/x-apple-aspen-config

		root * {$HOME}/mac-studio-ai-homeserver/services/network

		file_server

	}
	handle {
		reverse_proxy https://127.0.0.1:8443 {
			transport http {
				tls_insecure_skip_verify
			}
		}
	}
}

# Leafs hypometer (plain HTTP :8899)
hypometer.allen {
	tls {$HOME}/mac-studio-ai-homeserver/services/network/data/tls/hypometer.allen.crt {$HOME}/mac-studio-ai-homeserver/services/network/data/tls/hypometer.allen.key
	reverse_proxy 127.0.0.1:8899
}

hockey.allen {
	tls {$HOME}/mac-studio-ai-homeserver/services/network/data/tls/hockey.allen.crt {$HOME}/mac-studio-ai-homeserver/services/network/data/tls/hockey.allen.key
	reverse_proxy 127.0.0.1:8899
}


# DDR song/media library (plain HTTP :8787)
ddr.allen {
	tls {$HOME}/mac-studio-ai-homeserver/services/network/data/tls/ddr.allen.crt {$HOME}/mac-studio-ai-homeserver/services/network/data/tls/ddr.allen.key
	reverse_proxy 127.0.0.1:8787
}

# --- Inference ------------------------------------------------------------

# Ollama's OpenAI-compatible API (Qwen 27B). LAN-only.
# Clients: base_url = http://llm.allen/v1 (after DNS + CA trust), or
#          http://<server-ip>:11434/v1 directly.
llm.allen {
	tls {$HOME}/mac-studio-ai-homeserver/services/network/data/tls/llm.allen.crt {$HOME}/mac-studio-ai-homeserver/services/network/data/tls/llm.allen.key
	reverse_proxy 127.0.0.1:11434
}

# --- Plain-HTTP bootstrap -------------------------------------------------
# Devices cannot resolve *.allen until they use the portal DNS. This serves the
# one-click DNS helper and proxies enrollment/install paths to the portal's
# plain-HTTP listener on :8081.
http://{$LAN_IP} {
	handle /set-dns.command {
		root * {$HOME}/mac-studio-ai-homeserver/services/network
		file_server
	}
	handle /dns-profile.mobileconfig {
		header Content-Type application/x-apple-aspen-config
		root * {$HOME}/mac-studio-ai-homeserver/services/network
		file_server
	}
	handle {
		reverse_proxy 127.0.0.1:8081
	}
}
